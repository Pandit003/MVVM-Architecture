<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.MVVMArchitecture" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize your dark theme here. -->
        <item name="colorPrimary">#F3F4F6</item>
        <item name="colorOnPrimary">#111827</item>
        <item name="customBackgroundColor">#111827</item>
        <item name="colorPrimaryContainer">#283941</item>

    </style>
    <attr name="customBackgroundColor" format="color" />
    <attr name="colorPrimaryContainer" format="color" />

    <style name="bottomNavStyle" parent="Widget.Material3.BottomNavigationView">

        <!-- Background -->
        <item name="android:background">#111827</item>

        <!-- Selected item color -->
        <item name="itemIconTint">@color/bottom_nav_dark_colors</item>
        <item name="indicatorColor">@color/bottom_nav_dark_colors</item>
        <item name="itemActiveIndicatorStyle">@style/BottomNavActiveIndicator</item>
    </style>
    <style name="BottomNavActiveIndicator">

        <!-- Light green -->
        <item name="android:color">#103629</item>

        <!-- Proper pill size -->
        <item name="android:width">64dp</item>
        <item name="android:height">32dp</item>

        <!-- Rounded pill -->
        <item name="shapeAppearance">@style/BottomNavIndicatorShape</item>

    </style>

    <style name="BottomNavIndicatorShape">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">16dp</item>
    </style>
</resources>